<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Xabe.FFmpeg.Downloader</PackageId>
    <AssemblyName>Xabe.FFmpeg.Downloader</AssemblyName>
    <RootNamespace>Xabe.FFmpeg.Downloader</RootNamespace>
    <PackageTitle>Xabe.FFmpeg.Downloader</PackageTitle>
    <Description>Downloads the latest FFmpeg and FFprobe binaries for Windows, macOS, Linux or Android, so your .NET application can locate a working media toolkit at runtime.</Description>
