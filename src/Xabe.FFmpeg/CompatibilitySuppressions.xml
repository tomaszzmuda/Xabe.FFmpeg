<?xml version="1.0" encoding="utf-8"?>
<!-- https://learn.microsoft.com/dotnet/fundamentals/package-validation/diagnostic-ids -->
<!--
  Sole suppression in this project's package validation:

  CP0003 (assembly version of the new package must be >= baseline).
  The embedded AssemblyVersion tracks the package version (MinVer).
  Untagged development/pre-release packs are 6.0.0-alpha.* and are
  intentionally LOWER than the published 6.0.2 baseline; they are
  never published. Tagged releases derive strictly increasing
  versions from v* tags, so CP0003 cannot legitimately fire there,
  and any future REAL member-level break (CP0002/CP0004/...) is
  still a hard blocker. Scoped to this exact diagnostic only.
-->

<Suppressions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Suppression>
    <DiagnosticId>CP0003</DiagnosticId>
    <Target>Xabe.FFmpeg, Version=6.0.0.0, Culture=neutral, PublicKeyToken=null</Target>
    <Left>lib/netstandard2.0/Xabe.FFmpeg.dll</Left>
    <Right>lib/netstandard2.0/Xabe.FFmpeg.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
</Suppressions>